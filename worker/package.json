{
  "name": "techlog-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "check": "wrangler types && tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply techlog --local",
    "db:migrate:remote": "wrangler d1 migrations apply techlog --remote"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "wrangler": "4.153.0"
  }
}
